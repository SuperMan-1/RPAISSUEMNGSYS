# =============================================================================
# Supabase 연결 정보
#
# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. (.env.local 은 커밋되지 않는다)
#   Supabase 대시보드 → Project Settings → API 에서 복사
#
# Vercel 에 배포할 때도 같은 이름으로 환경변수 세 개를 등록한다.
# =============================================================================

# 프로젝트 주소
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# 공개용 키 (anon / publishable)
# 브라우저로 전달된다. 이 키 자체에는 권한이 없고 DB 의 RLS 정책이 실제 권한을 판정한다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 비밀 키 (service_role / secret)
# 모든 RLS 를 무시하는 마스터 키. 서버에서만 쓰며 브라우저로 절대 나가지 않는다.
# 이 앱에서는 관리자가 사용자 계정을 만들 때만 사용한다.
SUPABASE_SERVICE_ROLE_KEY=
