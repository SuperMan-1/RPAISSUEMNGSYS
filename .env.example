# =============================================================================
# Supabase 연결 정보
#
# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. (.env.local 은 커밋되지 않는다)
#   Supabase 대시보드 → Project Settings → API Keys 에서 복사
#
# 값을 채운 뒤에는 개발 서버를 다시 시작해야 한다.
# Next.js 는 .env.local 을 서버가 켜질 때 한 번만 읽는다.
#
# Vercel 에 배포할 때도 같은 이름으로 환경변수를 등록한다.
# =============================================================================

# 프로젝트 주소
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# 공개용 키 — sb_publishable_... 로 시작한다
# 브라우저로 전달된다. 이 키 자체에는 권한이 없고 DB 의 RLS 정책이 실제 권한을 판정한다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 비밀 키 — sb_secret_... 로 시작한다
# 모든 RLS 를 무시하는 마스터 키. 서버에서만 쓰며 브라우저로 절대 나가지 않는다.
# 이 앱에서는 관리자가 계정을 만들거나 비밀번호를 재설정할 때만 사용한다.
# 비워 두어도 나머지 기능은 모두 동작한다 (계정 생성만 Supabase 대시보드에서 해야 한다).
SUPABASE_SECRET_KEY=


# -----------------------------------------------------------------------------
# 예전 키를 쓰는 경우
#
# Supabase 가 anon / service_role 키를 publishable / secret 으로 바꾸는 중이다.
# 기존 프로젝트라 예전 키밖에 없다면 아래 이름으로 넣어도 그대로 동작한다.
# 둘 다 있으면 위쪽(새 이름)을 먼저 쓴다.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=


# =============================================================================
# 사내 SMTP (비밀번호 분실 시 임시비밀번호 발송)
#
# 이 값이 없으면 비밀번호 찾기 화면이 "관리자에게 문의하세요" 안내로 바뀐다.
# 나머지 기능은 설정 없이도 모두 동작한다.
#
# Vercel 에서 사내 메일 서버로 나가는 길이 막혀 있을 수 있다.
# 배포 후 비밀번호 찾기를 한 번 돌려 실제로 메일이 오는지 확인할 것.
# =============================================================================

# 메일 서버 주소와 포트
SMTP_HOST=
SMTP_PORT=587

# 465 면 true (접속부터 TLS), 587 이면 false (STARTTLS 로 올림).
# 비워 두면 포트를 보고 알아서 정한다.
SMTP_SECURE=

# 인증이 필요한 서버면 채운다. 사내에서 인증 없이 중계한다면 비워 둬도 된다.
SMTP_USER=
SMTP_PASSWORD=

# STARTTLS 를 반드시 쓸지. 비우면 465/25 가 아닌 포트에서 자동으로 켜진다.
# 켜져 있으면 암호화하지 못할 때 보내지 않고 실패한다 (평문 발송 방지).
# 평문 중계만 하는 사내 릴레이를 쓸 때만 false 로 내린다.
SMTP_REQUIRE_TLS=

# 서버 인증서 검증. 사내 사설 인증서라 붙지 못할 때만 false 로 내린다.
SMTP_TLS_REJECT_UNAUTHORIZED=

# 보내는 사람. "RPA 이슈관리 <noreply@example.co.kr>" 형태도 된다.
SMTP_FROM=

# 메일 본문에 넣을 사이트 주소. 비우면 요청 헤더에서 알아낸다.
# Vercel 처럼 주소가 고정된 곳에서는 적어 두는 쪽이 확실하다.
NEXT_PUBLIC_SITE_URL=
