# =============================================================================
# Supabase 연결 정보
#
# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. (.env.local 은 커밋되지 않는다)
#   Supabase 대시보드 → Project Settings → API Keys 에서 복사
#
# 값을 채운 뒤에는 개발 서버를 다시 시작해야 한다.
# Next.js 는 .env.local 을 서버가 켜질 때 한 번만 읽는다.
#
# Vercel 에 배포할 때도 같은 이름으로 환경변수를 등록한다.
# =============================================================================

# 프로젝트 주소
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# 공개용 키 — sb_publishable_... 로 시작한다
# 브라우저로 전달된다. 이 키 자체에는 권한이 없고 DB 의 RLS 정책이 실제 권한을 판정한다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 비밀 키 — sb_secret_... 로 시작한다
# 모든 RLS 를 무시하는 마스터 키. 서버에서만 쓰며 브라우저로 절대 나가지 않는다.
# 이 앱에서는 관리자가 계정을 만들거나 비밀번호를 재설정할 때만 사용한다.
# 비워 두어도 나머지 기능은 모두 동작한다 (계정 생성만 Supabase 대시보드에서 해야 한다).
SUPABASE_SECRET_KEY=


# -----------------------------------------------------------------------------
# 예전 키를 쓰는 경우
#
# Supabase 가 anon / service_role 키를 publishable / secret 으로 바꾸는 중이다.
# 기존 프로젝트라 예전 키밖에 없다면 아래 이름으로 넣어도 그대로 동작한다.
# 둘 다 있으면 위쪽(새 이름)을 먼저 쓴다.
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
